{
  "name": "tbpedia-analytics",
  "version": "0.1.19",
  "private": true,
  "type": "module",
  "description": "Offline-first Tbpedia reading capture for Obsidian and NocoDB",
  "scripts": {
    "build": "node scripts/build.mjs",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test tests/*.test.ts",
    "check": "npm run typecheck && npm test && npm run build",
    "worker:types": "wrangler types --config worker/wrangler.jsonc",
    "worker:dev": "wrangler dev --config worker/wrangler.jsonc",
    "worker:deploy": "wrangler deploy --config worker/wrangler.jsonc",
    "vault:audit": "tsx scripts/vault.ts audit",
    "vault:prepare": "tsx scripts/vault.ts prepare",
    "provision": "tsx scripts/provision-reader.ts"
  },
  "dependencies": {
    "yaml": "2.9.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "5.20261016.1",
    "@types/node": "26.6.5",
    "esbuild": "0.28.2",
    "obsidian": "1.14.4",
    "tsx": "4.23.15",
    "typescript": "7.0.2",
    "wrangler": "4.151.1"
  }
}
